<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Royal Gaming</title>

<style>
body {
  background: #090909;
  color: white;
  text-align: center;
  font-family: Arial;
  margin: 0;
}

header {
  padding: 20px;
  color: gold;
  border-bottom: 2px solid gold;
}

.card {
  background: #1b1b1b;
  border: 1px solid gold;
  border-radius: 15px;
  padding: 25px;
  margin: 20px;
}

#wheel {
  width: 220px;
  height: 220px;
  margin: 20px auto;
  border-radius: 50%;
  border: 6px solid gold;
  background: conic-gradient(
    #e8b923 0deg 60deg,
    #222 60deg 120deg,
    #e8b923 120deg 180deg,
    #222 180deg 240deg,
    #e8b923 240deg 300deg,
    #222 300deg 360deg
  );
  transition: transform 4s ease-out;
}

button {
  background: gold;
  padding: 14px 25px;
  border: none;
  border-radius: 10px;
  font-weight: bold;
  font-size: 17px;
}
</style>
</head>

<body>

<header>
<h1>👑 ROYAL GAMING</h1>
<p>Welcome to Royal Gaming</p>
</header>

<div class="coin">
🪙 Virtual Coins:
<span id="coins">100</span>
</div>

<div class="card">
<h2>🎡 Royal Spin Wheel</h2>
<div id="wheel"></div>
<button onclick="spinWheel()">SPIN NOW</button>
</div>

<div class="card">
<h2>🎁 Collect Coins</h2>
<button onclick="collectCoin()">COLLECT +5</button>
</div>

<div class="card">
<h2>👑 Royal Redeem</h2>
<p>Virtual coins only. No real money value.</p>
<button onclick="redeemCoin()">REDEEM 50 COINS</button>
</div>

<script src="spin.js"></script>

<script>
let coins = Number(localStorage.getItem("royalCoins"));

if (!Number.isFinite(coins) || coins < 0) {
  coins = 100;
  localStorage.setItem("royalCoins", coins);
}

function updateCoins() {
  document.getElementById("coins").innerText = coins;
}

function collectCoin() {
  coins += 5;
  localStorage.setItem("royalCoins", coins);
  updateCoins();
}

function redeemCoin() {
  if (coins >= 50) {
    coins -= 50;
    localStorage.setItem("royalCoins", coins);
    updateCoins();
    alert("50 Virtual Coins Redeemed!");
  } else {
    alert("Not enough Virtual Coins!");
  }
}

updateCoins();
</script>

</body>
</html>
